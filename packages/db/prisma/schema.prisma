generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                   @id @default(autoincrement())
  githubId            String                @unique @map("github_id")
  email               String                @unique
  name                String?
  avatarUrl           String?               @map("avatar_url")
  globalRole          String                @default("USER") @map("global_role")
  accessToken         String?               @map("access_token")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  apiKeys             ApiKey[]
  repositoryAccesses  RepositoryAccess[]
  reviewJobs          ReviewJob[]           @relation("RequesterJobs")
  notificationConfigs NotificationConfig[]

  @@map("users")
}

model RepositoryAccess {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  repositoryId Int        @map("repository_id")
  role         String     // MAINTAINER, DEVELOPER, VIEWER

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@map("repository_access")
}

model Repository {
  id             Int                @id @default(autoincrement())
  githubRepoId   String             @unique @map("github_repo_id")
  fullName       String             @map("full_name")
  createdAt      DateTime           @default(now()) @map("created_at")

  accesses       RepositoryAccess[]
  reviewJobs     ReviewJob[]

  @@map("repositories")
}

model ApiKey {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  keyHash      String    @unique @map("key_hash")
  name         String
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model ReviewJob {
  id           Int       @id @default(autoincrement())
  repositoryId Int       @map("repository_id")
  requesterId  Int       @map("user_id") // Maps to the User who requested it
  prNumber     Int       @map("pr_number")
  status       String    @default("QUEUED") // QUEUED, IN_PROGRESS, PENDING_FEEDBACK, COMPLETED, FAILED
  branchName   String?   @map("branch_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  requester    User       @relation("RequesterJobs", fields: [requesterId], references: [id], onDelete: Cascade)
  
  agentResults AgentResult[]
  finalReport  FinalReport?

  @@map("review_jobs")
}

model AgentResult {
  id          Int       @id @default(autoincrement())
  jobId       Int       @map("job_id")
  agentName   String    @map("agent_name")
  severity    String
  finding     String
  createdAt   DateTime  @default(now()) @map("created_at")

  job         ReviewJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("agent_results")
}

model FinalReport {
  id                 Int       @id @default(autoincrement())
  jobId              Int       @unique @map("job_id")
  reportUrl          String?   @map("report_url")
  synthesizedSummary String    @map("synthesized_summary")
  createdAt          DateTime  @default(now()) @map("created_at")

  job                ReviewJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("final_reports")
}

model NotificationConfig {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String    // SLACK, GITHUB_COMMENT
  webhookUrl  String    @map("webhook_url")
  isEnabled   Boolean   @default(true) @map("is_enabled")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_configs")
}
